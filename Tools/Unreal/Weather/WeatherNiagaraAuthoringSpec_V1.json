{
  "schemaVersion": 1,
  "assetAuthoringState": "spec_only_not_uasset",
  "engine": "Unreal Engine 5.8",
  "authoringBackend": "Monolith MCP niagara_query create_system_from_spec or equivalent UE Editor Niagara graph API",
  "owner": "GamePlatformVFX",
  "rules": {
    "neverCreateEmptySystem": true,
    "requireCompileAndSave": true,
    "requireReloadAndEmitterCount": true,
    "systemRoot": "/GamePlatformVFX/Weather/Niagara",
    "materialRoot": "/GamePlatformVFX/Weather/Materials",
    "qualityPolicy": "Reuse Niagara EffectType and client scalability; never replicate particles",
    "coordinatePolicy": "Spawn near local viewer; attach to view target root via Presentation.AttachComponent; keep in local simulation space and never spawn at world origin",
    "materials": [
      "M_GP_VFX_Weather_Rain",
      "M_GP_VFX_Weather_Snow",
      "M_GP_VFX_Weather_Splash"
    ]
  },
  "parameters": [
    {
      "name": "User.WeatherIntensity",
      "type": "Float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "雨雪粒子强度；按Presentation float白名单，直接传给Niagara"
    },
    {
      "name": "User.WeatherWind",
      "type": "Float",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "description": "横向风力；预留真正风向Vector的协议更新"
    },
    {
      "name": "User.WeatherExtent",
      "type": "Vector3",
      "default": [
        1800,
        1800,
        1400
      ],
      "description": "观察者局部降水生成盒厘米"
    },
    {
      "name": "User.LocalViewPosition",
      "type": "Position",
      "description": "选配；优先使用AttachedDefinition的ViewTarget SceneComponent"
    }
  ],
  "systems": [
