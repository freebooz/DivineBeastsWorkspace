      "folder": "Water",
      "zh": "两层水面扰动法线按水流相位及强度融合归一化",
      "pins": [
        {
          "name": "NormalA",
          "type": "V3",
          "preview": [
            0,
            0,
            1
          ]
        },
        {
          "name": "NormalB",
          "type": "V3",
          "preview": [
            0,
            0,
            1
          ]
        },
        {
          "name": "FlowPhase",
          "type": "S",
          "preview": 0.45
        },
        {
          "name": "DistortionStrength",
          "type": "S",
          "preview": 0.8
        }
      ],
      "outputs": [
        {
          "name": "Normal",
          "expression": [
            "normalize",
            [
              "lerp",
              "NormalA",
              "NormalB",
              [
                "sat",
                [
                  "mul",
                  "FlowPhase",
                  "DistortionStrength"
                ]
              ]
            ]
          ]
        }
      ]
    },
