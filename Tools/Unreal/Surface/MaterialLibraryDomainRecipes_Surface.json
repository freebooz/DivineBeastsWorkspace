                    "G"
                  ]
                ],
                [
                  "channel",
                  [
                    "sub",
                    "UV",
                    "CenterUV"
                  ],
                  "R"
                ]
              ],
              [
                "mul",
                [
                  "mul",
                  "TwistStrength",
                  [
                    "one_minus",
                    [
                      "sat",
                      [
                        "div",
                        [
                          "distance",
                          "UV",
                          "CenterUV"
                        ],
                        "InfluenceRadius"
                      ]
                    ]
                  ]
                ],
                "TimeSeconds"
              ]
            ]
          ]
        }
