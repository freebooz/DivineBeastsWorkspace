      "id": "MAT-09-06",
      "name": "VortexDistortion",
      "owner": "VFX",
      "folder": "VFX",
      "zh": "围绕指定UV中心按垂距衰减执行局部切向旋流纹理偏移",
      "pins": [
        {
          "name": "UV",
          "type": "V2",
          "preview": [
            0.5,
            0.5
          ]
        },
        {
          "name": "CenterUV",
          "type": "V2",
          "preview": [
            0.5,
            0.5
          ]
        },
        {
          "name": "InfluenceRadius",
          "type": "S",
          "preview": 0.6
        },
        {
          "name": "TwistStrength",
          "type": "S",
          "preview": 0.5
        },
        {
          "name": "TimeSeconds",
          "type": "S",
          "preview": 2
        }
      ],
      "outputs": [
        {
          "name": "UV",
          "expression": [
            "add",
            "UV",
            [
              "mul",
              [
                "append",
                [
                  "mul",
                  -1,
                  [
                    "channel",
                    [
                      "sub",
                      "UV",
                      "CenterUV"
