        {
            "Name": "GamePlatformDeveloperTools",
            "Type": "Editor",
            "LoadingPhase": "Default",
            "TargetAllowList": [ "Editor" ],
            "TargetConfigurationAllowList": [ "Debug", "DebugGame", "Development", "Test" ]
        }
    ]
}