{
  "Description": "第三层原稿UI材质证据；五张原稿RGB不改色，四张轮廓Alpha独立；动态技能图案采用原稿碧绿晶纹色系，不改变技能身份或授权。",
  "Materials": [
    {
      "path": "/DBAUIPack_Core/UI/Materials/Nature/M_DBA_NatureMenuReference",
      "spec": {
        "nodes": [
          {
            "id": "OriginalTexture",
            "class": "TextureObject",
            "props": {
              "Texture": "/DBAUIPack_Core/UI/Textures/Nature/T_DBA_NatureMenuReference"
            }
          },
          {
            "id": "UV",
            "class": "TextureCoordinate"
          },
          {
            "id": "OpaqueSilhouette",
            "class": "TextureObject",
            "props": {
              "Texture": "/DBAUIPack_Core/UI/Textures/Nature/T_DBA_NatureMenuReferenceMatte"
            }
          }
        ],
        "custom_hlsl_nodes": [
          {
            "id": "PreserveOriginalRGB",
            "code": "// 原稿RGB只采样，不加乘色或色调变换；命令文案区域从邻近无字石板重新取样。\nfloat2 P = UV;\nif (UV.x > 0.345 && UV.x < 0.71 && UV.y > 0.255 && UV.y < 0.745) P.x = 0.30 + frac((UV.x-0.345)*9.0)*0.035;\nfloat3 C = Texture2DSample(Source, SourceSampler, P).rgb;\n// 原稿深色背景仅改透明度；不把它当贴图颜色染黑。\nAlpha=Texture2DSample(Matte,MatteSampler,UV).a;\nreturn C;",
            "description": "保留原稿RGB，显示遮罩只修改Alpha；项目第三层客户端UI专用",
            "output_type": "float3",
            "inputs": [
              {
                "name": "Source"
              },
              {
                "name": "UV"
              },
              {
                "name": "Matte"
              }
            ],
            "additional_outputs": [
              {
                "name": "Alpha",
                "type": "float"
              }
            ]
          }
        ],
        "connections": [
          {
            "from": "OriginalTexture",
            "to": "PreserveOriginalRGB",
            "to_pin": "Source"
          },
          {
            "from": "UV",
            "to": "PreserveOriginalRGB",
            "to_pin": "UV"
          },
          {
            "from": "OpaqueSilhouette",
            "to": "PreserveOriginalRGB",
            "to_pin": "Matte"
          }
        ],
        "outputs": [
          {
            "from": "PreserveOriginalRGB",
            "to_property": "EmissiveColor"
          },
          {
            "from": "PreserveOriginalRGB",
            "from_pin": "Alpha",
            "to_property": "Opacity"
          }
        ]
      }
    },
    {
      "path": "/DBAUIPack_Core/UI/Materials/Nature/M_DBA_NatureAbilityReference",
      "spec": {
        "nodes": [
          {
            "id": "OriginalTexture",
            "class": "TextureObject",
            "props": {
              "Texture": "/DBAUIPack_Core/UI/Textures/Nature/T_DBA_NatureAbilityReference"
            }
          },
          {
            "id": "UV",
            "class": "TextureCoordinate"
          },
          {
            "id": "OpaqueSilhouette",
            "class": "TextureObject",
            "props": {
              "Texture": "/DBAUIPack_Core/UI/Textures/Nature/T_DBA_NatureAbilityReferenceMatte"
            }
          }
        ],
        "custom_hlsl_nodes": [
          {
            "id": "PreserveOriginalRGB",
            "code": "// 原稿RGB直采；动态肖像/数值保留既有替换窗口，技能间框线与右侧图案不整块挖空。\nfloat3 C=Texture2DSample(Source,SourceSampler,UV).rgb;\nAlpha=Texture2DSample(Matte,MatteSampler,UV).a;\nfloat2 Portrait=(UV-float2(.184,.488))/float2(.061,.183);\nif(dot(Portrait,Portrait)<1)Alpha=0;\nif(UV.x>.274&&UV.x<.735&&UV.y>.277&&UV.y<.31)Alpha=0;\nif(UV.x>.274&&UV.x<.735&&UV.y>.338&&UV.y<.366)Alpha=0;\n// 仅清理五个示意图案的内部；使用原稿不透明暗底，不使槽间或底座露出场景。\nfloat Slot=floor((UV.x-.276)/.09);\nfloat InnerX=UV.x-(.276+Slot*.09);\nif(Slot>=0&&Slot<5&&InnerX>.008&&InnerX<.070&&UV.y>.444&&UV.y<.625)C=Texture2DSample(Source,SourceSampler,float2(.767,.424)).rgb;\n// 示意快捷键由真实PlayerInput映射覆盖，底板保持不透明。\nif(Slot>=0&&Slot<5&&InnerX>.028&&InnerX<.054&&UV.y>.655&&UV.y<.695)C=Texture2DSample(Source,SourceSampler,float2(.31,.7)).rgb;\n// 右侧物品画面是装饰；擦除原稿3/1示意库存，不伪造实际背包数量。\nif((UV.x>.800&&UV.x<.820||UV.x>.864&&UV.x<.880)&&UV.y>.520&&UV.y<.579)C=Texture2DSample(Source,SourceSampler,float2(.767,.424)).rgb;\nif(UV.x>.168&&UV.x<.203&&UV.y>.633&&UV.y<.718)C=Texture2DSample(Source,SourceSampler,float2(.179+frac(UV.x*8)*.007,.635+frac(UV.y*8)*.007)).rgb;\nreturn C;",
            "description": "原稿RGB直采，动态数据遮罩；第三层客户端UI",
            "output_type": "float3",
            "inputs": [
              {
                "name": "Source"
              },
              {
                "name": "UV"
              },
              {
                "name": "Matte"
              }
            ],
            "additional_outputs": [
              {
                "name": "Alpha",
                "type": "float"
              }
            ]
          }
        ],
        "connections": [
          {
            "from": "OriginalTexture",
            "to": "PreserveOriginalRGB",
            "to_pin": "Source"
          },
          {
            "from": "UV",
            "to": "PreserveOriginalRGB",
            "to_pin": "UV"
          },
          {
            "from": "OpaqueSilhouette",
            "to": "PreserveOriginalRGB",
            "to_pin": "Matte"
          }
        ],
        "outputs": [
          {
            "from": "PreserveOriginalRGB",
            "to_property": "EmissiveColor"
          },
          {
            "from": "PreserveOriginalRGB",
            "from_pin": "Alpha",
            "to_property": "Opacity"
          }
        ]
      }
    },
    {
