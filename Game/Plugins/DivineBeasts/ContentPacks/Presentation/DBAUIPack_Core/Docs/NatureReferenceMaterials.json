            }
          }
        ],
        "custom_hlsl_nodes": [
          {
            "id": "PreserveOriginalRGB",
            "code": "// 原稿框架的RGB直接取样；示意角色、名称、属性数字和图腾由真实只读状态覆盖。\nfloat3 C=Texture2DSample(Source,SourceSampler,UV).rgb;\n// 轮廓Alpha与RGB亮度无关，石材暗部、藤蔓缝隙及玉石底色保持不透明。\nAlpha=Texture2DSample(Matte,MatteSampler,UV).a;\nfloat2 Portrait=(UV-float2(0.231,0.461))/float2(0.141,0.25);\nif(dot(Portrait,Portrait)<1) Alpha=0;\n// 玩家名称区域只用原稿无字绿色石板，不保留“玩家名称”示例。\nif(UV.x>0.552 && UV.x<0.727 && UV.y>0.228 && UV.y<0.298){\n float2 P=float2(0.535+frac(UV.x*5)*0.012,UV.y);\n C=Texture2DSample(Source,SourceSampler,P).rgb;\n}\nif(UV.x>0.471 && UV.x<0.886 && UV.y>0.383 && UV.y<0.438) Alpha=0;\nif(UV.x>0.471 && UV.x<0.886 && UV.y>0.496 && UV.y<0.55) Alpha=0;\n// 等级来源尚未接入，清除60示例；原生控件显示未知标记。\nif(UV.x>0.508 && UV.x<0.574 && UV.y>0.677 && UV.y<0.755) C=Texture2DSample(Source,SourceSampler,float2(.515+frac(UV.x*8)*.01,.656+frac(UV.y*8)*.005)).rgb;\nfloat2 Totem=(UV-float2(0.736,0.68))/float2(0.047,0.086);\nif(dot(Totem,Totem)<1) Alpha=0;\n// 图腾只是当前英雄肖像装饰，不恢复已取消的印记玩法。\nif(UV.x>0.695 && UV.x<0.794 && UV.y>0.775 && UV.y<0.818) C=Texture2DSample(Source,SourceSampler,float2(.693+frac(UV.x*8)*.007,UV.y)).rgb;\nreturn C;",
            "description": "原稿RGB直采，动态数据遮罩；第三层客户端UI",
            "output_type": "float3",
            "inputs": [
              {
                "name": "Source"
              },
              {
                "name": "UV"
              },
              {
                "name": "Matte"
              }
            ],
            "additional_outputs": [
