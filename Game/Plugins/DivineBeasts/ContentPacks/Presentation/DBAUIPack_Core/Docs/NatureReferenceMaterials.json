            "code": "// 原稿RGB保持不变；真实俯视底图只替换地图窗口，原稿标题、罗盘及缩放按钮全部保留。\nfloat3 C=Texture2DSample(Source,SourceSampler,UV).rgb;\nAlpha=Texture2DSample(Matte,MatteSampler,UV).a;\nbool MapWindow=distance(UV,float2(.5,.447))<.335;\nbool Plaque=UV.x>.35&&UV.x<.65&&UV.y>.112&&UV.y<.195;\nbool Compass=distance(UV,float2(.5,.204))<.036||distance(UV,float2(.175,.438))<.035||distance(UV,float2(.822,.439))<.035||distance(UV,float2(.5,.697))<.036;\nbool Buttons=distance(UV,float2(.844,.549))<.032||distance(UV,float2(.840,.614))<.032||distance(UV,float2(.828,.683))<.032;\nif(MapWindow&&!Plaque&&!Compass&&!Buttons)Alpha=0;\nreturn C;",
            "description": "保留原稿RGB，显示遮罩只修改Alpha；项目第三层客户端UI专用",
            "output_type": "float3",
            "inputs": [
              {
                "name": "Source"
              },
              {
                "name": "UV"
              },
              {
                "name": "Matte"
              }
            ],
            "additional_outputs": [
              {
                "name": "Alpha",
                "type": "float"
              }
            ]
          }
        ],
        "connections": [
          {
            "from": "OriginalTexture",
            "to": "PreserveOriginalRGB",
            "to_pin": "Source"
          },
          {
            "from": "UV",
            "to": "PreserveOriginalRGB",
            "to_pin": "UV"
          },
          {
            "from": "OpaqueSilhouette",
