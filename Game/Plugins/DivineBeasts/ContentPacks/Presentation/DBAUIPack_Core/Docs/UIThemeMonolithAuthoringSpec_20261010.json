  "AuthoringColorRules": {
    "DesignInput": "sRGB 8位十六进制设计色",
    "EngineProperty": "FLinearColor（线性颜色）",
    "ConversionZh": "Monolith实际set_cdo_properties写入颜色时必须先执行sRGB到线性颜色转换；不能将设计色RGB整数直接当作0至1线性值。",
    "FontZh": "保持既有中文可读字体和全部已审核字号，未确认覆盖中文字符的正式字体不得替换原有Font对象。",
    "BackgroundZh": "第一阶段可先用可伸缩深青灰Brush验证框架，但项目面板正式背景纹理须由Monolith导入青铜云纹Texture2D并填入BorderStyle.Background，不能用整屏Login背景充当功能面板纹理。"
  },
  "MonolithReadbackRequirementsZh": [
    "先核对正式编辑器的ProjectName=DivineBeastsArena与项目uproj绝对路径",
    "完成所有Blueprint及DataAsset的创建、编译、保存、关开后回读，逐个核对父类与soft类路径",
    "读取DA_DBA_UITheme_Default的5条StyleId、真实类软引用、逻辑ID和DataVersion，内容缺失则DefaultThemeDefinitionId仍保持空值",
    "回读现有登录与角色页面的ThemeBindings实际蓝图类默认值；若BP历史覆盖为空，用Monolith写入显式绑定，禁止改动WidgetTree和业务输入",
    "查看登录表单宽高、密码遮罩、键盘Tab和手柄焦点，主题应用前后必须一致",
    "标准面板Blueprint核对PanelBackground、PanelTitle、CloseButton、ContentSlot真实命名控件与父类",
    "开发对照主题存储在NeverCook目录，不注册为正式默认主题",
    "证据只由Monolith实际编译/保存/重载/AssetRegistry写入MonolithGenerationManifest，不得凭本Spec宣称已生成"
  ],
  "SafetyConstraints": [
    "所有真实蓝图和主题资产仅由Monolith MCP在正确UE5.8 Editor中创建修改",
    "编译、保存、关闭后回读所有实际资产并留MonolithGenerationManifest证据",
    "不以此JSON替代.uasset或证明美术验收通过",
    "启动前默认ThemeDefinitionId为空，只有完整主题、样式与页面绑定通过后才能启用",
    "现有登录LOGO、背景、字体大小、输入尺寸与控件焦点不改",
    "GamePlatformUI不可包含项目资源硬引用、DedicatedServer不能Cook客户端纯主题"
  ]
