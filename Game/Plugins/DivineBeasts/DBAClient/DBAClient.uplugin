{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0.0",
  "FriendlyName": "DBAClient",
  "Description": "神兽联盟公共客户端组合插件：装配项目流程、项目表现适配和用户界面，不强制启用竞技；DBAArena仅通过公开流程扩展接入。",
  "Category": "DivineBeasts",
  "CreatedBy": "DivineBeastsWorkspace",
  "CanContainContent": true,
  "EnabledByDefault": false,
  "Plugins": [
    { "Name": "DBAGameplay", "Enabled": true },
    { "Name": "DBAWorlds", "Enabled": true },
    { "Name": "GamePlatformCore", "Enabled": true },
    { "Name": "GamePlatformApplicationFlow", "Enabled": true },
    { "Name": "GamePlatformOnline", "Enabled": true },
    { "Name": "GamePlatformSession", "Enabled": true },
    { "Name": "GamePlatformLoading", "Enabled": true },
    { "Name": "GamePlatformData", "Enabled": true },
    { "Name": "GamePlatformCharacter", "Enabled": true },
    { "Name": "GamePlatformCombat", "Enabled": true },
    { "Name": "GamePlatformQuest", "Enabled": true },
    { "Name": "GamePlatformInventory", "Enabled": true },
    { "Name": "GamePlatformPresentation", "Enabled": true },
    { "Name": "GamePlatformUI", "Enabled": true }
  ],
  "Modules": [
    { "Name": "DivineBeastsApplicationFlowClient", "Type": "ClientOnly", "LoadingPhase": "Default" },
    { "Name": "DivineBeastsPresentationRuntime", "Type": "Runtime", "LoadingPhase": "Default" },
    { "Name": "DivineBeastsPresentationClient", "Type": "ClientOnly", "LoadingPhase": "Default" },
    { "Name": "DivineBeastsUIClient", "Type": "ClientOnly", "LoadingPhase": "Default" }
  ]
}
