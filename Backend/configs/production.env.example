# production.env.example（生产环境变量示例）仅展示键名和非敏感示例，禁止提交真实密钥。

# GatewayService（统一接入服务）内部HTTP模式地址；gRPC模式使用下面 *_GRPC_TARGET。
IDENTITY_SERVICE_URL=http://identityservice:8081
PLAYER_DATA_SERVICE_URL=http://playerdataservice:8082
MATCH_SERVICE_URL=http://matchservice:8083

# Backend内部gRPC目标。
IDENTITY_GRPC_TARGET=identityservice:9081
PLAYER_DATA_GRPC_TARGET=playerdataservice:9082
MATCH_GRPC_TARGET=matchservice:9083
GAME_SERVER_CONTROL_GRPC_TARGET=gameservercontrolservice:9084

# PostgreSQL（关系数据库）。真实用户名、密码必须从Secret注入。
POSTGRES_DSN=postgres://USER:PASSWORD@postgres:5432/divinebeasts?sslmode=require
POSTGRES_MAX_CONNS=32

# Redis（缓存/会话/幂等/TransferTicket防重放）。
REDIS_ADDRS=redis-0:6379,redis-1:6379,redis-2:6379
REDIS_MASTER_NAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=64
PARTY_TTL=24h
MATCHMAKING_TICKET_TTL=15m

# NATS JetStream（可靠集成事件）。
NATS_URL=nats://nats:4222

# Agones（MainArena服务器原子分配）。
AGONES_API_URL=https://kubernetes.default.svc
AGONES_NAMESPACE=divinebeasts
AGONES_BEARER_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
GAME_SERVER_BUILD_VERSION=1.0.0

# TransferTicket（跨服票据）签名密钥，生产必须由Secret注入且长度不少于32字节。
TRANSFER_TICKET_SECRET=REPLACE_WITH_SECRET

# Kubernetes Pod标识，用于Transactional Outbox Dispatcher租约Owner。
POD_NAME=gameservercontrolservice-0
