{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divinebeasts/contracts/events/arena-match-completed.schema.json",
  "title": "ArenaMatchCompleted（神兽联盟竞技比赛完成事件）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "matchId",
    "arenaModeId",
    "gameServerId",
    "occurredAt"
  ],
  "properties": {
    "eventType": {
      "const": "DivineBeasts.Arena.MatchCompleted"
    },
    "matchId": {
      "type": "string",
      "minLength": 1
    },
    "arenaModeId": {
      "$ref": "../Schemas/arena-mode.schema.json"
    },
    "gameServerId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
