{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameplatform/contracts/match/match-result.schema.json",
  "title": "MatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matchId",
    "arenaModeId",
    "gameServerId",
    "startedAt",
    "endedAt",
    "teams",
    "players"
  ],
  "properties": {
    "matchId": {
      "type": "string",
      "minLength": 1
    },
    "arenaModeId": {
      "type": "string",
      "minLength": 1
    },
    "gameServerId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "winningTeamId": {
      "type": [
        "string",
        "null"
      ]
    },
    "teams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "teamId",
          "won",
          "score"
        ],
        "properties": {
          "teamId": {
            "type": "string",
            "minLength": 1
          },
          "won": {
            "type": "boolean"
          },
          "score": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playerId",
          "teamId",
          "characterId",
          "kills",
          "deaths",
          "assists"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1
          },
          "teamId": {
            "type": "string",
            "minLength": 1
          },
          "characterId": {
            "type": "string",
            "minLength": 1
          },
          "kills": {
            "type": "integer",
            "minimum": 0
          },
          "deaths": {
            "type": "integer",
            "minimum": 0
          },
          "assists": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
