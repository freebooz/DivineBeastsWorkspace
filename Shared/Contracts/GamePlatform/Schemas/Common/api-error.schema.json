{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gameplatform/contracts/common/api-error.schema.json",
  "title": "ApiError",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "errorCode",
    "message",
    "requestId",
    "traceId",
    "retryable"
  ],
  "properties": {
    "errorCode": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
