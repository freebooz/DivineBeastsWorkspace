diff --git a/Engine/Source/Runtime/Online/HTTP/Private/Tests/HttpRedirectPolicyTests.cpp b/Engine/Source/Runtime/Online/HTTP/Private/Tests/HttpRedirectPolicyTests.cpp
new file mode 100644
index 0000000..ace60d2
--- /dev/null
+++ b/Engine/Source/Runtime/Online/HTTP/Private/Tests/HttpRedirectPolicyTests.cpp
@@ -0,0 +1,169 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#if WITH_DEV_AUTOMATION_TESTS && WITH_CURL
+
+#include "Async/Async.h"
+#include "Curl/CurlHttp.h"
+#include "HttpModule.h"
+#include "Interfaces/IHttpResponse.h"
+#include "Misc/AutomationTest.h"
+#include "Misc/CommandLine.h"
+#include "Misc/Parse.h"
+
+// 只暴露已有生命周期供测试使用，不给生产请求添加测试后门。
+class FRedirectPolicyLifecycleRequest final : public FCurlHttpRequest
+{
+public:
+	bool SetupForTest() { return SetupRequest(); }
+	void CleanupForTest() { CleanupRequest(); }
+};
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHttpRedirectPolicyContractTest,
+	"System.HTTP.RedirectPolicy.Contract", EAutomationTestFlags::ApplicationContextMask | EAutomationTestFlags::EngineFilter)
+
+bool FHttpRedirectPolicyContractTest::RunTest(const FString& Parameters)
+{
+	FHttpModule::Get();
+	FRedirectPolicyLifecycleRequest Request;
+	TestFalse(TEXT("未实现的基类后端不能声称支持策略"), Request.IHttpRequest::SetRedirectPolicy(EHttpRequestRedirectPolicy::Reject));
+	TestTrue(TEXT("游戏线程闲置请求接受Reject"), Request.SetRedirectPolicy(EHttpRequestRedirectPolicy::Reject));
+	TestFalse(TEXT("非法枚举被拒绝"), Request.SetRedirectPolicy(static_cast<EHttpRequestRedirectPolicy>(255)));
+	Request.SetStatus(EHttpRequestStatus::Processing);
+	TestFalse(TEXT("飞行中不能改策略"), Request.SetRedirectPolicy(EHttpRequestRedirectPolicy::Follow));
+	Request.SetStatus(EHttpRequestStatus::NotStarted);
+	TestFalse(TEXT("非游戏线程不能改策略"), Async(EAsyncExecution::Thread, [&Request]() {
+		return Request.SetRedirectPolicy(EHttpRequestRedirectPolicy::Follow);
+	}).Get());
+	Request.SetURL(TEXT("http://127.0.0.1/unused-no-network"));
+	TestTrue(TEXT("延迟创建句柄时Setup成功"), Request.SetupForTest());
+	Request.CleanupForTest();
+	TestTrue(TEXT("清理后重建句柄仍可Setup"), Request.SetupForTest());
+	Request.CleanupForTest();
+	TestTrue(TEXT("闲置时允许恢复显式Follow"), Request.SetRedirectPolicy(EHttpRequestRedirectPolicy::Follow));
+	return true;
+}
+
+namespace
+{
+// 独立于测试对象持有回调结果；超时先解绑再取消，不让迟到回调访问已结束测试。
+struct FRedirectPolicyNetworkState
+{
+	FHttpRequestPtr Request;
+	bool bDone = false;
+	bool bSucceeded = false;
+	bool bSawLocation = false;
+	int32 StatusCallback = 0;
+	int32 Code = 0;
+	FString Body;
+};
+
+class FRedirectPolicyNetworkCommand final : public IAutomationLatentCommand
+{
+public:
+	FRedirectPolicyNetworkCommand(FAutomationTestBase* InTest, FString InOrigin)
+		: Test(InTest), Origin(MoveTemp(InOrigin)), RunId(FGuid::NewGuid().ToString(EGuidFormats::Digits)) {}
+
+	virtual bool Update() override
+	{
+		if (!State)
+		{
+			State = MakeShared<FRedirectPolicyNetworkState>();
+			State->Request = FHttpModule::Get().CreateRequest();
+			State->Request->SetDelegateThreadPolicy(EHttpRequestDelegateThreadPolicy::CompleteOnGameThread);
+			State->Request->SetTimeout(10.0f);
+			const auto Result = State;
+			State->Request->OnStatusCodeReceived().BindLambda([Result](FHttpRequestPtr, int32 Code) { Result->StatusCallback = Code; });
+			State->Request->OnHeaderReceived().BindLambda([Result](FHttpRequestPtr, const FString& Key, const FString&) {
+				Result->bSawLocation |= Key.Equals(TEXT("Location"), ESearchCase::IgnoreCase);
+			});
+			State->Request->OnProcessRequestComplete().BindLambda([Result](FHttpRequestPtr, FHttpResponsePtr Response, bool bSucceeded) {
+				Result->bSucceeded = bSucceeded;
+				Result->Code = Response ? Response->GetResponseCode() : 0;
+				Result->Body = Response ? Response->GetContentAsString() : FString();
+				Result->bDone = true;
+			});
+			if (Step < 10)
+			{
+				const int32 Codes[] = {301, 302, 303, 307, 308};
+				State->Request->SetURL(FString::Printf(TEXT("%s/redirect/%d/%s/%s"), *Origin, Codes[Step % 5], Step < 5 ? TEXT("same") : TEXT("cross"), *RunId));
+				State->Request->SetVerb(TEXT("POST"));
+				State->Request->SetHeader(TEXT("Authorization"), TEXT("Bearer redirect-policy-test-only"));
+				State->Request->SetContentAsString(TEXT("redirect-policy-test-body"));
+				if (!State->Request->SetRedirectPolicy(EHttpRequestRedirectPolicy::Reject))
+				{
+					Test->AddError(TEXT("当前HTTP后端未接受Reject，不能继续发送"));
+					ReleaseRequest();
+					return true;
+				}
+			}
+			else
+			{
+				State->Request->SetURL(Origin + TEXT("/sink-count/") + RunId);
+				State->Request->SetVerb(TEXT("GET"));
+			}
+			StartedAt = FPlatformTime::Seconds();
+			if (!State->Request->ProcessRequest())
+			{
+				Test->AddError(TEXT("真实HTTP请求未启动"));
+				ReleaseRequest();
+				return true;
+			}
+		}
+		if (!State->bDone && FPlatformTime::Seconds() - StartedAt < 15.0) { return false; }
+		if (!State->bDone)
+		{
+			Test->AddError(TEXT("真实HTTP测试超时"));
+			ReleaseRequest();
+			return true;
+		}
+		Test->TestTrue(TEXT("收到真实HTTP响应"), State->bSucceeded);
+		if (Step < 10)
+		{
+			const int32 Codes[] = {301, 302, 303, 307, 308};
+			Test->TestEqual(TEXT("Reject保留原3xx响应"), State->Code, Codes[Step % 5]);
+			Test->TestEqual(TEXT("Reject不吞status回调"), State->StatusCallback, Codes[Step % 5]);
+			Test->TestTrue(TEXT("Reject不吞Location header回调"), State->bSawLocation);
+		}
+		else
+		{
+			Test->TestEqual(TEXT("夹具统计可读"), State->Code, 200);
+			Test->TestEqual(TEXT("同源/跨源目标均不得收到任何请求或凭据"), State->Body, FString(TEXT("0")));
+		}
+		ReleaseRequest();
+		return ++Step > 10;
+	}
+
+private:
+	void ReleaseRequest()
+	{
+		State->Request->OnStatusCodeReceived().Unbind();
+		State->Request->OnHeaderReceived().Unbind();
+		State->Request->OnProcessRequestComplete().Unbind();
+		if (!State->bDone) { State->Request->CancelRequest(); }
+		State.Reset();
+	}
+	FAutomationTestBase* Test;
+	FString Origin;
+	FString RunId;
+	TSharedPtr<FRedirectPolicyNetworkState> State;
+	int32 Step = 0;
+	double StartedAt = 0.0;
+};
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHttpRedirectPolicyNetworkTest,
+	"System.HTTP.RedirectPolicy.LoopbackNetwork", EAutomationTestFlags::ApplicationContextMask | EAutomationTestFlags::EngineFilter)
+
+bool FHttpRedirectPolicyNetworkTest::RunTest(const FString& Parameters)
+{
+	FString Origin;
+	if (!FParse::Value(FCommandLine::Get(), TEXT("HttpRedirectPolicyTestOrigin="), Origin) || !Origin.StartsWith(TEXT("http://127.0.0.1:")))
+	{
+		AddError(TEXT("必须显式提供已启动测试夹具的回环Origin；缺失不是网络验收通过"));
+		return false;
+	}
+	ADD_LATENT_AUTOMATION_COMMAND(FRedirectPolicyNetworkCommand(this, MoveTemp(Origin)));
+	return true;
+}
+
+#endif // WITH_DEV_AUTOMATION_TESTS && WITH_CURL
