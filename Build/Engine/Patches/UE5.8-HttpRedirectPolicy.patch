+bool FCurlHttpRequest::ApplyRedirectPolicy()
+{
+	const CURLcode Result = curl_easy_setopt(EasyHandle, CURLOPT_FOLLOWLOCATION,
+		RedirectPolicy == EHttpRequestRedirectPolicy::Follow ? 1L : 0L);
+	if (Result != CURLE_OK)
+	{
+		// 不记录URL、header或凭据；任何真实选项失败都必须阻止本次发送。
+		UE_LOGF(LogHttp, Error, "Failed to apply request redirect policy (curl code %d)", static_cast<int32>(Result));
+		return false;
+	}
+	return true;
+}
+
+bool FCurlHttpRequest::SetRedirectPolicy(EHttpRequestRedirectPolicy Policy)
+{
+	if (!IsInGameThread() || CompletionStatus == EHttpRequestStatus::Processing ||
+		(Policy != EHttpRequestRedirectPolicy::Follow && Policy != EHttpRequestRedirectPolicy::Reject))
+	{
+		return false;
+	}
+	RedirectPolicy = Policy;
+	// 无句柄时只记录选择，Setup/Init必须再次以真实curl返回值作为发送门禁。
+	bRedirectPolicySetFailed = EasyHandle && !ApplyRedirectPolicy();
+	return !bRedirectPolicySetFailed;
+}
